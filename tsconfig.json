{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@barefootjs/jsx"
  },
  "include": ["web/src/**/*.ts", "web/src/**/*.tsx", "vite.config.ts"]
}
