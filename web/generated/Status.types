package views

import (
	"math/rand"

	bf "github.com/barefootjs/runtime/bf"
)

// StatusRowsItem is a synthesised type for an anonymous object type (#2674).
type StatusRowsItem struct {
	Label string `json:"label"`
	Value string `json:"value"`
}

// StatusInput is the user-facing input type.
type StatusInput struct {
	ScopeID string // Optional: if empty, random ID is generated
	BfParent string // Optional: parent scope id
	BfMount string // Optional: slot id in parent
	Text interface{}
	State string
	StateClass string
	Error string
	Stale bool
	LastSuccess string
	LastAttempt string
	Rows []StatusRowsItem
}

// StatusProps is the props type for the Status component.
type StatusProps struct {
	ScopeID string `json:"-"`
	BfIsRoot bool `json:"-"`
	BfIsChild bool `json:"-"`
	BfParent string `json:"-"`
	BfMount string `json:"-"`
	BfDataKey string `json:"-"`
	Scripts *bf.ScriptCollector `json:"-"`
	BfCallerProps map[string]interface{} `json:"-"`
	Text interface{} `json:"text"`
	State string `json:"state"`
	StateClass string `json:"stateClass"`
	Error string `json:"error"`
	Stale bool `json:"stale"`
	LastSuccess string `json:"lastSuccess"`
	LastAttempt string `json:"lastAttempt"`
	Rows []StatusRowsItem `json:"rows"`
}

// NewStatusProps creates StatusProps from StatusInput.
func NewStatusProps(in StatusInput) StatusProps {
	scopeID := in.ScopeID
	if scopeID == "" {
		scopeID = "Status_" + randomID(6)
	}

	bfCallerProps := map[string]interface{}{}
	bfCallerProps["text"] = in.Text
	bfCallerProps["state"] = in.State
	bfCallerProps["stateClass"] = in.StateClass
	bfCallerProps["error"] = in.Error
	bfCallerProps["stale"] = in.Stale
	bfCallerProps["lastSuccess"] = in.LastSuccess
	bfCallerProps["lastAttempt"] = in.LastAttempt
	bfCallerProps["rows"] = in.Rows

	return StatusProps{
		ScopeID: scopeID,
		BfParent: in.BfParent,
		BfMount: in.BfMount,
		BfCallerProps: bfCallerProps,
		Text: in.Text,
		State: in.State,
		StateClass: in.StateClass,
		Error: in.Error,
		Stale: in.Stale,
		LastSuccess: in.LastSuccess,
		LastAttempt: in.LastAttempt,
		Rows: in.Rows,
	}
}