package views

import (
	"math/rand"

	bf "github.com/barefootjs/runtime/bf"
)

// PageCardsItem is a synthesised type for an anonymous object type (#2674).
type PageCardsItem struct {
	ID string `json:"id"`
	Name string `json:"name"`
}

// PageInput is the user-facing input type.
type PageInput struct {
	ScopeID string // Optional: if empty, random ID is generated
	BfParent string // Optional: parent scope id
	BfMount string // Optional: slot id in parent
	Text interface{}
	Title string
	DetailID string
	Cards []PageCardsItem
}

// PageProps is the props type for the Page component.
type PageProps struct {
	ScopeID string `json:"-"`
	BfIsRoot bool `json:"-"`
	BfIsChild bool `json:"-"`
	BfParent string `json:"-"`
	BfMount string `json:"-"`
	BfDataKey string `json:"-"`
	Scripts *bf.ScriptCollector `json:"-"`
	BfCallerProps map[string]interface{} `json:"-"`
	Text interface{} `json:"text"`
	Title string `json:"title"`
	DetailID string `json:"detailID"`
	Cards []PageCardsItem `json:"cards"`
	ControlsSlot23 ControlsProps `json:"-"`
}

// NewPageProps creates PageProps from PageInput.
func NewPageProps(in PageInput) PageProps {
	scopeID := in.ScopeID
	if scopeID == "" {
		scopeID = "Page_" + randomID(6)
	}

	bfCallerProps := map[string]interface{}{}
	bfCallerProps["text"] = in.Text
	bfCallerProps["title"] = in.Title
	bfCallerProps["detailID"] = in.DetailID
	bfCallerProps["cards"] = in.Cards

	return PageProps{
		ScopeID: scopeID,
		BfParent: in.BfParent,
		BfMount: in.BfMount,
		BfCallerProps: bfCallerProps,
		Text: in.Text,
		Title: in.Title,
		DetailID: in.DetailID,
		Cards: in.Cards,
		ControlsSlot23: NewControlsProps(ControlsInput{
			ScopeID: scopeID + "_s23",
			BfParent: scopeID,
			BfMount: "s23",
			DeviceID: in.DetailID,
			Text: in.Text,
		}),
	}
}