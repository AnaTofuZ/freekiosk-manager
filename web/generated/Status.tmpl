{{define "Status"}}
<div bf-s="{{bfScopeAttr .}}" {{bfHydrationAttrs .}} {{bfPropsAttr .}}{{if .BfDataKey}} data-key="{{.BfDataKey}}"{{end}} bf="s18"><p class="state {{.StateClass}}" bf="s1">{{bfTextStart "s0"}}{{.State}}{{bfTextEnd}}</p>{{if ne (bf_string .Error) ""}}<p bf-c="s2" class="error" bf="s4">{{bfTextStart "s3"}}{{.Error}}{{bfTextEnd}}</p>{{else}}{{bfComment "cond-start:s2"}}{{bfComment "cond-end:s2"}}{{end}}{{if .Stale}}<p bf-c="s5" class="hint" bf="s7">{{bfTextStart "s6"}}{{.Text.ShowingTheLastSuccessfulStatus}}{{bfTextEnd}}</p>{{else}}{{bfComment "cond-start:s5"}}{{bfComment "cond-end:s5"}}{{end}}<dl bf="s10">{{bfComment "loop:l0"}}{{range $_, $row := .Rows}}<div class="status-row" data-key="{{.Label}}"><dt>{{bfTextStart "s8"}}{{.Label}}{{bfTextEnd}}</dt><dd>{{bfTextStart "s9"}}{{.Value}}{{bfTextEnd}}</dd></div>{{end}}{{bfComment "/loop:l0"}}</dl><p class="timestamp" bf="s17">{{bfTextStart "s11"}}{{.Text.LastSuccess}}{{bfTextEnd}}<time bf="s13">{{bfTextStart "s12"}}{{.LastSuccess}}{{bfTextEnd}}</time><br>{{bfTextStart "s14"}}{{.Text.LastAttempt}}{{bfTextEnd}}<time bf="s16">{{bfTextStart "s15"}}{{.LastAttempt}}{{bfTextEnd}}</time></p></div>
{{end}}
